# Copy to .env and fill in. .env is gitignored and never committed.

# Hosted chat models (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=

# Claude, through Anthropic's Messages API (`uv sync --extra claude`)
ANTHROPIC_API_KEY=

# Embeddings (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Local models served by Ollama on another machine
OLLAMA_BASE_URL=http://192.168.1.50:11434/v1

# Postgres with the pgvector and pg_trgm extensions (`docker compose up -d --wait`)
DATABASE_URL=postgresql://recon:recon@localhost:5433/recon
